{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "cypherdoc",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "/**"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "description"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "param_tag"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "returns_tag"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "*/"
        }
      ]
    },
    "name": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "description": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "description_line"
      }
    },
    "description_line": {
      "type": "PATTERN",
      "value": "[^@\\n *][^\\n]*"
    },
    "param_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@param"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "type_annotation"
          }
        },
        {
          "type": "FIELD",
          "name": "param",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "required_param"
              },
              {
                "type": "SYMBOL",
                "name": "optional_param"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "returns_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@returns"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "returns_type_annotation"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "required_param": {
      "type": "FIELD",
      "name": "name",
      "content": {
        "type": "SYMBOL",
        "name": "identifier"
      }
    },
    "optional_param": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "default",
          "content": {
            "type": "SYMBOL",
            "name": "param_default"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "param_default": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string_default"
        },
        {
          "type": "SYMBOL",
          "name": "number_default"
        },
        {
          "type": "SYMBOL",
          "name": "boolean_default"
        }
      ]
    },
    "string_default": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "\"[^\"]*\""
        },
        {
          "type": "PATTERN",
          "value": "'[^']*'"
        }
      ]
    },
    "number_default": {
      "type": "PATTERN",
      "value": "-?[0-9]+(\\.[0-9]+)?"
    },
    "boolean_default": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "type_annotation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "scalar_type"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "returns_type_annotation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "tuple_type"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "tuple_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "tuple_member"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "SYMBOL",
                    "name": "tuple_member"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "array_marker"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "tuple_member": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "column",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "scalar_type"
          }
        }
      ]
    },
    "array_marker": {
      "type": "STRING",
      "value": "[]"
    },
    "scalar_type": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "<"
                },
                {
                  "type": "FIELD",
                  "name": "argument",
                  "content": {
                    "type": "SYMBOL",
                    "name": "type_argument"
                  }
                },
                {
                  "type": "STRING",
                  "value": ">"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "type_argument": {
      "type": "FIELD",
      "name": "value",
      "content": {
        "type": "SYMBOL",
        "name": "identifier"
      }
    },
    "tag_description": {
      "type": "PATTERN",
      "value": "-[^\\n]*"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "PATTERN",
      "value": "[ \\t]*\\*[ \\t\\n]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}